# Canonical production site URL (used for SEO metadata, hreflang, and sitemap)
NEXT_PUBLIC_SITE_URL=https://publimarca.do

# Optional: Webhook or email service endpoint for commission brief delivery.
# NOTE: If neither COMMISSION_WEBHOOK_URL nor RESEND_API_KEY is set,
# /api/commission returns 503 so the UI never fakes a successful backend submission.
COMMISSION_WEBHOOK_URL=
RESEND_API_KEY=
COMMISSION_RECEIVER_EMAIL=dispatch@publimarca.do
